# =============================================================================
# QABuddy.ai - Example Environment Configuration
# Copy this file to .env and fill in your real values:
#   cp .env.example .env

# 1. Cloud LLM Generation Layer (Groq API Settings)
GROQ_API_KEY=gsk_ENTER_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# 2. Cloud Vectorization Layer (Google Gemini Embedding Settings)
GEMINI_API_KEY=AIzaSyENTER_YOUR_GEMINI_API_KEY_HERE
EMBEDDING_MODEL_NAME=models/gemini-embedding-001
EMBEDDING_DIM=768

# 3. Reranker (Cohere) - leave empty to use the Groq LLM rerank fallback
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# 4. Vector Database Layer (Qdrant Cloud - set these for production)
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6YjcwZDIyNzktZjc0ZS00MTFhLTljODEtZWQ5MWM2M2JhNjI5In0.gICNfsKW_rxCAMonex_oXpWkBhJO15xqqiUKbxG4IDo
COLLECTION_NAME=qabuddy_chunks
RETRIEVE_TOP_K=30
RERANK_TOP_N=20
TOP_K=5

# 5. Storage Architecture Configuration
DATA_DIRECTORY=./data
